# ...but the retraining pipeline's source and hand-curated data belong in git.
# Without these negations, new files under scripts/ are silently ignored while
# the already-tracked ones stay visible — see the pipeline README.
!backend/course_custom_ner_model/scripts/
!backend/course_custom_ner_model/metadata/
backend/course_custom_ner_model/scripts/__pycache__/
backend/course_custom_ner_model/scripts/.pytest_cache/

